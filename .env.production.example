# Copy this to `.env` in the deploy directory ON THE SERVER (not in the repo)
# and fill in real values.
#
# NEVER QUOTE VALUES IN THIS FILE. docker-compose reads it via `env_file:`,
# and unlike a shell or Laravel's own .env parser, that reader does NOT strip
# surrounding quotes: APP_KEY="base64:abc..." arrives inside the container as
# the literal string `"base64:abc..."`, quotes included. Laravel then fails to
# match the `base64:` prefix, treats the whole thing as a raw key, and every
# request dies with "Unsupported cipher or incorrect key length". Values with
# spaces need no quoting here; everything after the first `=` is the value.
#
# Generate APP_KEY once with (note: no quotes around the result):
#   echo "base64:$(openssl rand -base64 32)"

APP_NAME=Reads Admin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.kitoblarim.uz

LOG_CHANNEL=stack
LOG_LEVEL=error

# SQLite — no separate database container needed. Must be an absolute path
# under storage/, which is the volume that survives deploys.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Reads (the public Next.js site) posts inquiries from the visitor's own
# browser at tarjima.kitoblarim.uz — a different origin — straight to this
# API. config/cors.php already allows any origin for api/* with no
# credentials, so no CORS changes are needed here; this is just documenting
# why that cross-origin request works.
