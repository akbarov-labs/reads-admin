APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Public site (the Next.js app this API feeds) -------------------------
# Used to build the SEO defaults this API hands to the site, and to decide
# which browser origin may POST the inquiry form here.
SEO_SITE_NAME=Reads
SEO_SITE_URL=http://localhost:3000

# Webhook on the public site, called after every write so a new book shows
# up (and enters the sitemap) immediately instead of waiting out the site's
# ISR window. The secret must match REVALIDATE_SECRET in the Reads .env.
# Leave the URL blank to turn the pings off entirely.
SEO_REVALIDATE_URL=
SEO_REVALIDATE_SECRET=

# Shared secret for the Kitoblarim bot's catalogue sync (/api/sync/*), sent as
# `Authorization: Bearer <token>`. Leave blank to switch the sync endpoints
# off (they answer 503). Generate one with: openssl rand -hex 32
CATALOGUE_SYNC_TOKEN=

# Browser origins allowed to call this API cross-origin. Defaults to
# SEO_SITE_URL plus APP_URL; localhost and LAN addresses are matched by
# pattern outside production, so local development needs nothing here.
CORS_ALLOWED_ORIGINS=
